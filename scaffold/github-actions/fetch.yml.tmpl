# VendKit engine fetch (DR-0016) — engine-owned reusable composite action.
# Fetches the pinned engine, verifies it against the release SHA256SUMS.txt,
# caches it, and puts it on PATH. Scaffolded by `vendkit init` so
# consumer-authored workflows reference this instead of hand-rolling the
# fetch (a hand-rolled curl that quietly skips the checksum is invisible to
# upstream):
#
#   steps:
#     - uses: actions/checkout@v4
#     - uses: ./.github/actions/vendkit-fetch
#     - run: vendkit gate --all --strict
#
# The scaffolded vendkit lanes stay self-contained; this action is for the
# repository's OWN pipelines. Local runs use ./vendkitw, which follows the
# same resolve → fetch → verify-before-exec order.
name: vendkit fetch
description: >-
  Fetch the pinned vendkit engine, verify it against the release
  SHA256SUMS.txt, cache it, and put it on PATH (DR-0016).
runs:
  using: composite
  steps:
    - name: Restore cached vendkit engine
      id: engine-cache
      uses: actions/cache@v4
      with:
        path: ${{ runner.temp }}/vendkit-bin
        key: vendkit-engine-__VERSION__-${{ runner.os }}-${{ runner.arch }}
    - name: Fetch + verify pinned vendkit engine (DR-0016)
      if: steps.engine-cache.outputs.cache-hit != 'true'
      shell: bash
      env:
        # vendkit-pin __SLICE__ — engine ref, advanced with the content pin
        # by the sync PR (INV-6: one version for engine and content).
        ENGINE_REF: refs/tags/__VERSION__
        PUBLISHER: __PUBLISHER_REPO__
        # Override to a mirror for offline/air-gapped runs; the checksum pin
        # still decides trust (DR-0016).
        ENGINE_BASE_URL: ${{ vars.VENDKIT_ENGINE_BASE_URL }}
      run: |
        set -euo pipefail
        version="${ENGINE_REF#refs/tags/}"
        os=linux; arch=amd64
        case "$(uname -m)" in aarch64|arm64) arch=arm64 ;; esac
        asset="vendkit_${version}_${os}_${arch}"
        # Priority: pipeline variable > committed engine.base_url (issue #15,
        # a version-independent release root) > the slice publisher's GitHub
        # release assets (correct exactly when it also publishes the engine).
        base="${ENGINE_BASE_URL:-}"
        root="__ENGINE_BASE_URL__"
        if [ -z "$base" ] && [ -n "$root" ]; then base="${root%/}/${version}"; fi
        base="${base:-https://github.com/${PUBLISHER}/releases/download/${version}}"
        dir="${RUNNER_TEMP}/vendkit-bin"; mkdir -p "$dir"
        curl -fsSL -o "$dir/vendkit" "${base}/${asset}"
        curl -fsSL -o "$dir/SHA256SUMS.txt" "${base}/SHA256SUMS.txt"
        want="$(grep " ${asset}\$" "$dir/SHA256SUMS.txt" | cut -d' ' -f1)"
        echo "${want}  ${dir}/vendkit" | sha256sum -c -
        chmod +x "$dir/vendkit"
    - name: Put vendkit on PATH
      shell: bash
      run: echo "${RUNNER_TEMP}/vendkit-bin" >> "$GITHUB_PATH"
